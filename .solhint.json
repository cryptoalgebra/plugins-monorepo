{
  "extends": "solhint:recommended",
  "plugins": [],
  "rules": {
    "compiler-version": ["error", "^0.8.20"],
    "quotes": ["error", "single"],
    "func-visibility": ["warn", { "ignoreConstructors": true }],
    "max-line-length": "off",
    "no-empty-blocks": "off",
    "no-inline-assembly": "off",
    "not-rely-on-time": "off",
    "reason-string": ["warn", { "maxLength": 64 }],
    "no-unused-vars": "error",
    "no-unused-private-funcs": "warn",
    "state-visibility": "error",
    "var-name-mixedcase": "warn",
    "func-name-mixedcase": "warn",
    "const-name-snakecase": "warn",
    "private-vars-leading-underscore": "off",
    "avoid-low-level-calls": "off",
    "avoid-call-value": "off",
    "immutable-vars-naming": ["warn", { "immutablesAsConstants": false }],
    "gas-custom-errors": "off",
    "gas-indexed-events": "off",
    "gas-strict-inequalities": "off",
    "gas-small-strings": "off",
    "gas-increment-by-one": "off",
    "gas-calldata-parameters": "off",
    "gas-struct-packing": "off",
    "use-natspec": "off",
    "one-contract-per-file": "off",
    "no-global-import": "off",
    "import-path-check": "off",
    "use-forbidden-name": "off",
    "function-max-lines": "off",
    "max-states-count": "off"
  }
}
